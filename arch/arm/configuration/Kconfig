config MCUX_PRJSEG_config.arm.warn_as_error
    bool

config MCUX_PRJSEG_config.arm.suppress.warn_as_error
    bool "Disable warnings-as-errors"
    default n
    help
        Turn off warn as error globally for ARM project segment.

config MCUX_PRJSEG_config.arm.shared
    bool
    imply MCUX_COMPONENT_utilities.misc_utilities
    imply MCUX_PRJSEG_config.arm.warn_as_error if !MCUX_PRJSEG_config.arm.suppress.warn_as_error

config MCUX_PRJSEG_config.kinetis.shared
    bool
    default y if MCUX_HW_SOC_SERIES_KINETIS
    imply MCUX_PRJSEG_config.arm.shared

config MCUX_PRJSEG_config.rt.shared
    bool
    default y if MCUX_HW_SOC_SERIES_RT
    imply MCUX_PRJSEG_config.arm.shared

config MCUX_PRJSEG_config.imx.shared
    bool
    default y if MCUX_HW_SOC_SERIES_MIMX
    imply MCUX_PRJSEG_config.arm.shared

config MCUX_PRJSEG_config.imx.cortex_a.shared
    bool
    default y if (MCUX_PRJSEG_config.imx.shared && CPU_CORTEX_A)

config MCUX_PRJSEG_config.imx.cortex_m.shared
    bool
    default y if (MCUX_PRJSEG_config.imx.shared && CPU_CORTEX_M)

config MCUX_PRJSEG_config.lpc.shared
    bool
    default y if MCUX_HW_SOC_SERIES_LPC
    imply MCUX_PRJSEG_config.arm.shared

config MCUX_PRJSEG_config.mcx.shared
    bool
    default y if MCUX_HW_SOC_SERIES_MCX
    imply MCUX_PRJSEG_config.arm.shared

config MCUX_PRJSEG_config.wireless.shared
    bool
    default y if MCUX_HW_SOC_SERIES_WIRELESS
    imply MCUX_PRJSEG_config.arm.shared

config MCUX_PRJSEG_config.device_core.define
    bool
    default y
