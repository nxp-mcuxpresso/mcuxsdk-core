config MCUX_HAS_COMPONENT_driver.dsc_lpspi
    bool
    default y if MCUX_HW_IP_DriverType_DSC_LPSPI

config MCUX_COMPONENT_driver.dsc_lpspi
    bool "lpspi"
    select MCUX_COMPONENT_driver.common
    depends on MCUX_HAS_COMPONENT_driver.dsc_lpspi

if MCUX_COMPONENT_driver.dsc_lpspi
    config SPI_RETRY_TIMES
        int "Max loops to wait for operation complete (0 means wait forever)"
        default 0
        help
          This parameter defines how many loops to check completion before return timeout.
          If defined as 0, driver will wait forever until completion.
endif
