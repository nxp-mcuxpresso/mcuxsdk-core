config MCUX_DEPENDENCY_COMPONENT_driver.qspi_mcxe247
    bool
    default y if MCUX_HW_DEVICE_ID_MCXE247

config MCUX_COMPONENT_driver.qspi_mcxe247
    bool
    default y if MCUX_DEPENDENCY_COMPONENT_driver.qspi_mcxe247 && MCUX_COMPONENT_driver.qspi
    depends on MCUX_DEPENDENCY_COMPONENT_driver.qspi_mcxe247

config MCUX_DEPENDENCY_COMPONENT_driver.qspi_mcxe31b
    bool
    default y if MCUX_HW_DEVICE_ID_MCXE31B

config MCUX_COMPONENT_driver.qspi_mcxe31b
    bool
    default y if MCUX_DEPENDENCY_COMPONENT_driver.qspi_mcxe31b && MCUX_COMPONENT_driver.qspi
    depends on MCUX_DEPENDENCY_COMPONENT_driver.qspi_mcxe31b

config MCUX_DEPENDENCY_COMPONENT_driver.qspi_mcxe32b
    bool
    default y if MCUX_HW_DEVICE_ID_MCXE32B

config MCUX_COMPONENT_driver.qspi_mcxe32b
    bool
    default y if MCUX_DEPENDENCY_COMPONENT_driver.qspi_mcxe32b && MCUX_COMPONENT_driver.qspi
    depends on MCUX_DEPENDENCY_COMPONENT_driver.qspi_mcxe32b

config MCUX_DEPENDENCY_COMPONENT_driver.qspi_mcxe327
    bool
    default y if MCUX_HW_DEVICE_ID_MCXE327

config MCUX_COMPONENT_driver.qspi_mcxe327
    bool
    default y if MCUX_DEPENDENCY_COMPONENT_driver.qspi_mcxe327 && MCUX_COMPONENT_driver.qspi
    depends on MCUX_DEPENDENCY_COMPONENT_driver.qspi_mcxe327

config MCUX_HAS_COMPONENT_driver.qspi_edma
    bool
    default y if MCUX_HAS_COMPONENT_driver.qspi && (MCUX_HAS_COMPONENT_driver.edma || MCUX_HAS_COMPONENT_driver.edma_unified)

config MCUX_DEPENDENCY_COMPONENT_driver.qspi_imx
    bool
    default y if MCUX_HW_DEVICE_MCIMX7U5 || MCUX_HW_DEVICE_MCIMX7U3 ||\
                 MCUX_HW_DEVICE_MIMX8MQ6 || MCUX_HW_DEVICE_MIMX8MQ5 ||\
                 MCUX_HW_DEVICE_MIMX8MQ7 || MCUX_HW_DEVICE_MIMX8MD6 ||\
                 MCUX_HW_DEVICE_MIMX8MD7

config MCUX_HAS_COMPONENT_driver.qspi
    bool
    default y if MCUX_HW_IP_DriverType_QUADSPI
    default y if MCUX_DEPENDENCY_COMPONENT_driver.qspi_imx

config MCUX_COMPONENT_driver.qspi_edma
    bool "qspi_edma"
    select MCUX_COMPONENT_driver.qspi
    select MCUX_COMPONENT_driver.edma if MCUX_HAS_COMPONENT_driver.edma
    select MCUX_COMPONENT_driver.edma_unified if MCUX_HAS_COMPONENT_driver.edma_unified
    depends on MCUX_HAS_COMPONENT_driver.qspi_edma

config MCUX_COMPONENT_driver.qspi
    bool "qspi"
    select MCUX_COMPONENT_driver.common
    depends on MCUX_HAS_COMPONENT_driver.qspi
