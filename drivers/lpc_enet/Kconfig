config MCUX_HAS_COMPONENT_driver.lpc_enet
    bool
    default y if MCUX_HW_IP_DriverType_LPC_ENET

config MCUX_COMPONENT_driver.lpc_enet
    bool "lpc_enet"
    select MCUX_COMPONENT_driver.common
    depends on MCUX_HAS_COMPONENT_driver.lpc_enet

if MCUX_COMPONENT_driver.lpc_enet
    config ENET_SETMII_DELAY
        int "NOP loop count to let a MAC config write settle in ENET_SetMII"
        default 1000
        help
            Number of __NOP() iterations ENET_SetMII waits after a MAC_CONFIG write
            before writing the same register again. Increase it when the CPU clock is
            much faster than the MAC transmit/receive clock.
endif
