config MCUX_HAS_COMPONENT_driver.rt2k_pmu
    bool
    default y if MCUX_HW_IP_DriverType_RT2K_PMU

config MCUX_COMPONENT_driver.rt2k_pmu
    bool "rt2k_pmu"
    select MCUX_COMPONENT_driver.common
    depends on MCUX_HAS_COMPONENT_driver.rt2k_pmu

if MCUX_COMPONENT_driver.rt2k_pmu
    config PMU_BB_UPDATE_TIMEOUT
    int "Max loops to wait for PMU body bias update done."
    default 0
    help
        The PMU_BB_CFG_DONE bit field will be set once new
        settings of body bias completed.
        If defined as 0, the driver will wait until completion.

    config PMU_DRIVER_UPDATE_TRIM_VALUE
    bool "Let PMU_ConfigBodyBias write the N-well/P-well trim fields"
    default n
    help
        Parts whose P-Well/N-Well body-bias fuse is not yet trimmed rely on ROM to
        apply the trim directly to PMU_BODYBIAS_CONFIG_REG; PMU_ConfigBodyBias() must
        not overwrite it. With this option disabled (default), PMU_ConfigBodyBias()
        does a read-modify-write that leaves the NWELL_VOL/PWELL_VOL bitfields alone.
        Enable this only once the fuse is trimmed and a caller-supplied trim value is
        meant to be written to hardware.

endif
